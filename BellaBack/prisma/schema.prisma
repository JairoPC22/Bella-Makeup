generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Branch {
  id           String       @id @default(uuid())
  name         String
  address      String?
  phone        String?
  schedule     String?
  managerName  String?      @map("manager_name")
  // Nullable on purpose: no seeded branch currently has real coordinates.
  // The public storefront's nearest-branch computation already handles a
  // null lat/lng pair by skipping that logic (see PublicBranch in
  // BellaFront/src/types/api.ts), so leaving these unset for existing rows
  // is the honest choice rather than fabricating coordinates.
  lat          Float?
  lng          Float?
  status       BranchStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")

  userBranches UserBranch[]
  auditLogs    AuditLog[]
  inventory    Inventory[]
  inventoryMovements InventoryMovement[]
  sales        Sale[]
  transfersOut Transfer[]   @relation("TransferSourceBranch")
  transfersIn  Transfer[]   @relation("TransferDestinationBranch")
  orders       Order[]
  purchases    Purchase[]
  cashSessions CashSession[]
  returns      Return[]
  mermas       Merma[]

  @@map("branches")
}

model User {
  id           String     @id @default(uuid())
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  displayName  String     @map("display_name")
  username     String     @unique
  email        String     @unique
  phone        String?
  passwordHash String     @map("password_hash")
  // Supervisor authorization PIN — a SECOND credential, distinct from
  // passwordHash, used only for the in-person co-sign primitive
  // (POST /api/auth/verify-pin): a supervisor physically types it on the
  // cashier's already-logged-in screen to authorize a sensitive action,
  // the way a manager's key-turn authorizes a register override.
  // Nullable because most staff never set one — only supervisor/manager/
  // admin-grade users are expected to. Hashed with the exact same bcrypt
  // utility as passwordHash (utils/password.ts), never stored in plaintext,
  // and stripped at the API boundary by toPublicUser alongside passwordHash.
  pinHash      String?    @map("pin_hash")
  avatarStyle  String     @default("adventurer") @map("avatar_style")
  avatarSeed   String     @map("avatar_seed")
  roleId       String     @map("role_id")
  status       UserStatus @default(ACTIVE)
  allBranches  Boolean    @default(false) @map("all_branches")
  createdAt    DateTime   @default(now()) @map("created_at")
  lastLoginAt  DateTime?  @map("last_login_at")

  role          Role           @relation(fields: [roleId], references: [id])
  userBranches  UserBranch[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  inventoryMovements InventoryMovement[]
  conversationParticipations ConversationParticipant[]
  messagesAuthored Message[]      @relation("MessagesAuthored")
  salesMade     Sale[]         @relation("SalesMade")
  transfersRequested Transfer[]  @relation("TransfersRequested")
  transfersReceived  Transfer[]  @relation("TransfersReceived")
  purchasesCreated   Purchase[]  @relation("PurchasesCreated")
  purchasesReceived  Purchase[]  @relation("PurchasesReceived")
  cashSessions       CashSession[] @relation("CashSessionsOpened")
  returnsProcessed   Return[]      @relation("ReturnsProcessed")
  returnsAuthorized  Return[]      @relation("ReturnsAuthorized")
  mermasRequested    Merma[]       @relation("MermasRequested")
  mermasAuthorized   Merma[]       @relation("MermasAuthorized")

  @@map("users")
}

model UserBranch {
  userId   String @map("user_id")
  branchId String @map("branch_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model CompanySettings {
  id            String   @id @default(uuid())
  companyName   String   @map("company_name")
  address       String?
  phone         String?
  socialLinks   Json?    @map("social_links")
  logoUrl       String?  @map("logo_url")
  currency      String   @default("MXN")
  description   String?
  businessHours String?  @map("business_hours")
  taxId         String?  @map("tax_id")
  website       String?
  returnPolicy  String?  @map("return_policy")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  module     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  branchId   String?  @map("branch_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([module])
  @@index([userId])
  @@index([createdAt])
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum MovementType {
  ADJUSTMENT
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  // Online-storefront checkout/cancel — mirrors SALE's own pattern (a
  // single type reused for both the decrement at checkout and the
  // restoration on cancel, exactly like saleService.ts's cancelSale reuses
  // "SALE" rather than introducing a separate reversal type) instead of a
  // TRANSFER_IN/TRANSFER_OUT-style directional pair, since an online order
  // is structurally a sale (single branch, single direction), not a
  // two-branch movement.
  ORDER
}

model Category {
  id        String    @id @default(uuid())
  name      String
  status    ProductStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")

  products  Product[]

  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  status    ProductStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")

  products  Product[]

  @@map("brands")
}

model Product {
  id            String        @id @default(uuid())
  sku           String        @unique
  barcode       String?
  name          String
  description   String?
  categoryId    String?       @map("category_id")
  brandId       String?       @map("brand_id")
  cost          Decimal       @default(0) @db.Decimal(10, 2)
  price         Decimal       @db.Decimal(10, 2)
  promoPrice    Decimal?      @map("promo_price") @db.Decimal(10, 2)
  taxRate       Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2)
  minStock      Int           @default(0) @map("min_stock")
  maxStock      Int?          @map("max_stock")
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")

  category      Category?     @relation(fields: [categoryId], references: [id])
  brand         Brand?        @relation(fields: [brandId], references: [id])
  images        ProductImage[]
  variants      ProductVariant[]
  inventory     Inventory[]
  movements     InventoryMovement[]
  saleItems     SaleItem[]
  transferItems TransferItem[]
  orderItems    OrderItem[]
  purchaseItems PurchaseItem[]
  returnItems   ReturnItem[]
  mermaItems    MermaItem[]

  @@map("products")
  @@index([categoryId])
  @@index([brandId])
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  url        String
  isPrimary  Boolean  @default(false) @map("is_primary")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id          String    @id @default(uuid())
  productId   String    @map("product_id")
  name        String
  sku         String    @unique
  barcode     String?
  imageUrl    String?   @map("image_url")
  price       Decimal?  @db.Decimal(10, 2)
  minStock    Int       @default(0) @map("min_stock")
  maxStock    Int?      @map("max_stock")
  status      ProductStatus @default(ACTIVE)

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory   Inventory[]
  movements   InventoryMovement[]
  saleItems   SaleItem[]
  transferItems TransferItem[]
  orderItems  OrderItem[]
  purchaseItems PurchaseItem[]
  returnItems ReturnItem[]
  mermaItems  MermaItem[]

  @@map("product_variants")
}

model Inventory {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  variantId  String?  @map("variant_id")
  branchId   String   @map("branch_id")
  stock      Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branch     Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId, branchId])
  @@map("inventory")
  @@index([branchId])
}

model InventoryMovement {
  id            String       @id @default(uuid())
  productId     String       @map("product_id")
  variantId     String?      @map("variant_id")
  branchId      String       @map("branch_id")
  type          MovementType
  quantity      Int
  stockBefore   Int          @map("stock_before")
  stockAfter    Int          @map("stock_after")
  reference     String?
  userId        String?      @map("user_id")
  createdAt     DateTime     @default(now()) @map("created_at")

  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branch        Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("inventory_movements")
  @@index([productId])
  @@index([branchId])
  @@index([createdAt])
}

model InventoryAdjustment {
  id           String   @id @default(uuid())
  movementId   String   @unique @map("movement_id")
  reason       String
  authorizedBy String?  @map("authorized_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("inventory_adjustments")
}

model Conversation {
  id        String   @id @default(uuid())
  isGroup   Boolean  @default(false) @map("is_group")
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  userId         String    @map("user_id")
  joinedAt       DateTime  @default(now()) @map("joined_at")
  lastReadAt     DateTime? @map("last_read_at")
  hiddenAt       DateTime? @map("hidden_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  authorId       String   @map("author_id")
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User                @relation("MessagesAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@map("messages")
  @@index([conversationId, createdAt])
  @@index([createdAt])
}

model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  fileName  String   @map("file_name")
  url       String
  mimeType  String   @map("mime_type")
  size      Int
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

model Customer {
  id        String   @id @default(uuid())
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  phone     String?
  email     String?
  createdAt DateTime @default(now()) @map("created_at")

  sales  Sale[]
  orders Order[]

  @@map("customers")
  @@index([phone])
}

model Sale {
  id            String     @id @default(uuid())
  folio         Int        @default(autoincrement())
  branchId      String     @map("branch_id")
  userId        String     @map("user_id")
  customerId    String?    @map("customer_id")
  subtotal      Decimal    @db.Decimal(10, 2)
  discountTotal Decimal    @default(0) @map("discount_total") @db.Decimal(10, 2)
  taxTotal      Decimal    @default(0) @map("tax_total") @db.Decimal(10, 2)
  total         Decimal    @db.Decimal(10, 2)
  status        SaleStatus @default(COMPLETED)
  // Nullable on purpose: a sale is NOT required to belong to a cash-drawer
  // session. Online-order-adjacent and any non-POS code path keeps writing
  // sales with this left null, exactly as before. Only a POS sale rung up
  // by a cashier who currently has an OPEN CashSession at that same branch
  // gets auto-attached (see saleService.createSale), which is what makes
  // the blind close-time reconciliation able to sum "this shift's sales"
  // without the POS frontend having to thread a session id through
  // checkout.
  cashSessionId String?    @map("cash_session_id")
  cancelledAt   DateTime?  @map("cancelled_at")
  cancelledBy   String?    @map("cancelled_by")
  cancelReason  String?    @map("cancel_reason")
  createdAt     DateTime   @default(now()) @map("created_at")

  branch      Branch        @relation(fields: [branchId], references: [id])
  user        User          @relation("SalesMade", fields: [userId], references: [id])
  customer    Customer?     @relation(fields: [customerId], references: [id])
  cashSession CashSession?  @relation(fields: [cashSessionId], references: [id])
  items       SaleItem[]
  payments    SalePayment[]
  returns     Return[]

  @@map("sales")
  @@index([branchId, createdAt])
  @@index([userId])
  @@index([cashSessionId])
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String   @map("sale_id")
  productId String   @map("product_id")
  variantId String?  @map("variant_id")
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2)
  discount  Decimal  @default(0) @db.Decimal(10, 2)
  lineTotal Decimal  @map("line_total") @db.Decimal(10, 2)

  sale        Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  returnItems ReturnItem[]

  @@map("sale_items")
}

model SalePayment {
  id        String        @id @default(uuid())
  saleId    String        @map("sale_id")
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  reference String?

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_payments")
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model Transfer {
  id                  String         @id @default(uuid())
  folio               Int            @default(autoincrement())
  sourceBranchId      String         @map("source_branch_id")
  destinationBranchId String         @map("destination_branch_id")
  status              TransferStatus @default(PENDING)
  requestedByUserId   String         @map("requested_by_user_id")
  receivedByUserId    String?        @map("received_by_user_id")
  notes               String?
  cancelReason        String?        @map("cancel_reason")
  dispatchedAt        DateTime?      @map("dispatched_at")
  completedAt         DateTime?      @map("completed_at")
  cancelledAt         DateTime?      @map("cancelled_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  sourceBranch      Branch @relation("TransferSourceBranch", fields: [sourceBranchId], references: [id])
  destinationBranch Branch @relation("TransferDestinationBranch", fields: [destinationBranchId], references: [id])
  requestedBy       User   @relation("TransfersRequested", fields: [requestedByUserId], references: [id])
  receivedBy        User?  @relation("TransfersReceived", fields: [receivedByUserId], references: [id])
  items             TransferItem[]

  @@map("transfers")
  @@index([sourceBranchId])
  @@index([destinationBranchId])
  @@index([createdAt])
}

model TransferItem {
  id         String @id @default(uuid())
  transferId String @map("transfer_id")
  productId  String @map("product_id")
  variantId  String? @map("variant_id")
  quantity   Int

  transfer Transfer        @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("transfer_items")
}

// ---------- Online storefront orders ----------
// The DB model is `Order` (not `OnlineOrder`) — nothing else in this schema
// claims the name. `OnlineOrder` is only the frontend's TS interface name
// (see BellaFront/src/types/api.ts); orderService.ts maps this model to
// that exact shape at the API boundary.

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

model Order {
  id              String          @id @default(uuid())
  folio           Int             @default(autoincrement())
  customerId      String          @map("customer_id")
  status          OrderStatus     @default(PENDING)
  fulfillmentType FulfillmentType @map("fulfillment_type")
  // For PICKUP this is the branch the customer chose to collect from; for
  // DELIVERY it's still customer/frontend-supplied for now (nearest-branch
  // auto-routing needs the lat/lng data this task doesn't populate for the
  // seeded branches) — matches OnlineOrderFulfillment's discriminated union
  // in BellaFront/src/types/api.ts, which always includes a branchId for
  // both variants.
  branchId        String          @map("branch_id")
  deliveryAddress String?         @map("delivery_address")
  deliveryLat     Float?          @map("delivery_lat")
  deliveryLng     Float?          @map("delivery_lng")
  paymentMethod   PaymentMethod   @map("payment_method")
  subtotal        Decimal         @db.Decimal(10, 2)
  taxTotal        Decimal         @default(0) @map("tax_total") @db.Decimal(10, 2)
  total           Decimal         @db.Decimal(10, 2)
  notes           String?
  cancelReason    String?         @map("cancel_reason")
  confirmedAt     DateTime?       @map("confirmed_at")
  cancelledAt     DateTime?       @map("cancelled_at")
  completedAt     DateTime?       @map("completed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  customer Customer    @relation(fields: [customerId], references: [id])
  branch   Branch      @relation(fields: [branchId], references: [id])
  items    OrderItem[]

  @@map("orders")
  @@index([branchId])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  variantId String? @map("variant_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

// ---------- Compras (purchasing / supplier receiving) ----------
// Mirrors the Transfer lifecycle's discipline ("congelado en tránsito, solo
// se suma lo confirmado") but for supplier deliveries: a Purchase is created
// with EXPECTED quantities and moves no stock at all, then a single receive
// step records what physically ARRIVED and applies only that. A short or
// over delivery is not an error — it's recorded as a discrepancy and the
// stock still moves by the real amount, exactly like receiveTransfer never
// blocks on a mismatch.

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

// Deliberately no separate RECEIVING state: like Transfer, receiving happens
// in one shot inside a single transaction, so a persisted intermediate state
// would never be observable. PENDING is the only pre-receipt state; the two
// terminal "received" states differ only by whether every line matched.
enum PurchaseStatus {
  PENDING
  COMPLETED
  RECEIVED_WITH_DISCREPANCIES
  CANCELLED
}

model Supplier {
  id          String         @id @default(uuid())
  name        String
  contactName String?        @map("contact_name")
  phone       String?
  email       String?
  status      SupplierStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at")

  purchases Purchase[]

  @@map("suppliers")
}

model Purchase {
  id               String         @id @default(uuid())
  folio            Int            @default(autoincrement())
  supplierId       String         @map("supplier_id")
  branchId         String         @map("branch_id")
  // Free-text invoice/remission number printed on the supplier's paperwork —
  // not unique and not validated, since suppliers each use their own format.
  reference        String?
  status           PurchaseStatus @default(PENDING)
  createdByUserId  String         @map("created_by_user_id")
  receivedByUserId String?        @map("received_by_user_id")
  notes            String?
  cancelReason     String?        @map("cancel_reason")
  createdAt        DateTime       @default(now()) @map("created_at")
  receivedAt       DateTime?      @map("received_at")
  cancelledAt      DateTime?      @map("cancelled_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  branch     Branch         @relation(fields: [branchId], references: [id])
  createdBy  User           @relation("PurchasesCreated", fields: [createdByUserId], references: [id])
  receivedBy User?          @relation("PurchasesReceived", fields: [receivedByUserId], references: [id])
  items      PurchaseItem[]

  @@map("purchases")
  @@index([branchId])
  @@index([supplierId])
  @@index([createdAt])
}

model PurchaseItem {
  id               String  @id @default(uuid())
  purchaseId       String  @map("purchase_id")
  productId        String  @map("product_id")
  variantId        String? @map("variant_id")
  expectedQuantity Int     @map("expected_quantity")
  // Null until the purchase is received. 0 is a meaningful, distinct value
  // ("the line was checked and nothing arrived"), which is exactly why this
  // is nullable rather than defaulting to 0.
  receivedQuantity Int?    @map("received_quantity")
  // What was actually paid for this line on THIS delivery. Kept per-line and
  // immutable so historical purchases still show the cost in effect at the
  // time, independent of Product.cost drifting later.
  unitCost         Decimal @map("unit_cost") @db.Decimal(10, 2)

  purchase Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("purchase_items")
  @@index([purchaseId])
}

// ---------- Caja / cash-drawer sessions (blind close) ----------
// A cashier declares an opening float ("apertura"), rings up POS sales all
// shift (which silently accrue to this session via Sale.cashSessionId), and
// at shift end ("cierre") physically counts the drawer and submits that
// count WITHOUT ever having been shown what the system expects. Only the
// close response reveals systemCashTotal/systemCardTotal and the signed
// differences. This is the whole anti-fraud point: a cashier who could see
// the expected total first could retrofit their "physical count" to match
// it. Every read path a cashier can reach before closing therefore omits
// the system-total fields entirely (see cashSessionService.mapSession) —
// they are not merely null in the DB, they are absent from the JSON, so a
// later refactor can't accidentally start leaking a live running total.
enum CashSessionStatus {
  OPEN
  // Both declared totals matched the system exactly (difference 0.00).
  CLOSED
  // Closed, but cash and/or card came out over or short. Not an error
  // condition — a recorded, auditable fact, exactly like
  // PurchaseStatus.RECEIVED_WITH_DISCREPANCIES.
  CLOSED_WITH_DISCREPANCY
}

model CashSession {
  id           String            @id @default(uuid())
  branchId     String            @map("branch_id")
  userId       String            @map("user_id")
  openingFloat Decimal           @map("opening_float") @db.Decimal(10, 2)
  status       CashSessionStatus @default(OPEN)

  // ---- Blind declaration (written only at close, by the cashier) ----
  // Array of { denomination: number, count: number } — the physical
  // bill/coin count. Kept as JSON rather than a child table because it is
  // an immutable snapshot of one manual count, never queried per-row.
  declaredCashBreakdown Json?    @map("declared_cash_breakdown")
  // Derived sum of the breakdown. Stored (not recomputed from the JSON on
  // every read) so the close response and any later listing don't have to
  // re-walk the array.
  declaredCashTotal     Decimal? @map("declared_cash_total") @db.Decimal(10, 2)
  // The cashier's own count of card vouchers, submitted equally blind.
  declaredCardTotal     Decimal? @map("declared_card_total") @db.Decimal(10, 2)

  // ---- Revealed truth (computed server-side at the moment of close) ----
  // Summed from this session's own COMPLETED Sales' SalePayments. CANCELLED
  // sales are excluded by construction, so a void mid-shift simply never
  // counts. Covers PaymentMethod.CASH and PaymentMethod.CARD specifically —
  // the two buckets the cashier actually declares; TRANSFER/OTHER are
  // deliberately in neither.
  systemCashTotal Decimal? @map("system_cash_total") @db.Decimal(10, 2)
  systemCardTotal Decimal? @map("system_card_total") @db.Decimal(10, 2)
  // declared - system, signed: positive = over (sobrante), negative = short
  // (faltante), exactly 0 = cuadró.
  cashDifference  Decimal? @map("cash_difference") @db.Decimal(10, 2)
  cardDifference  Decimal? @map("card_difference") @db.Decimal(10, 2)

  openedAt DateTime  @default(now()) @map("opened_at")
  closedAt DateTime? @map("closed_at")

  branch Branch @relation(fields: [branchId], references: [id])
  user   User   @relation("CashSessionsOpened", fields: [userId], references: [id])
  sales  Sale[]

  @@map("cash_sessions")
  @@index([branchId, status])
  @@index([userId, status])
  @@index([openedAt])
}

// ---------- Devoluciones y cambios (returns / exchanges) ----------
// One Return row is ONE counter transaction: the customer hands back some
// lines of an original ticket and may simultaneously take new merchandise in
// their place. Both directions live in the same ReturnItem table,
// discriminated by `direction`, because they are two halves of a single
// negotiated event — splitting them into separate tables would let a refund
// exist without its exchange or vice versa, and the whole point of this
// module is that the two are reconciled into ONE balance the cashier settles
// at the counter.
//
// Deliberately NOT modelled as a negative Sale: a Sale is an immutable
// revenue document, and cancelSale already covers the "undo the whole
// ticket" case. A partial return against an old ticket is a different fact
// with a different authorization trail (a supervisor co-signed it) and its
// own folio series, so it gets its own document.

enum ReturnResolution {
  // newItemsTotal == returnedTotal — the customer swapped like for like and
  // no money changes hands.
  EXACT_EXCHANGE
  // newItemsTotal > returnedTotal — the customer pays the difference now,
  // which is why `paymentMethod` is only meaningful in this case.
  CUSTOMER_OWES
  // newItemsTotal < returnedTotal (including a pure refund, where
  // newItemsTotal is 0) — the business owes the customer.
  REFUND_OWED
}

enum ReturnItemDirection {
  // Physically came back over the counter, priced at what the customer
  // originally paid on the source SaleItem.
  RETURNED
  // Went back out with the customer in exchange, priced fresh at today's
  // resolved price.
  NEW
}

model Return {
  id             String @id @default(uuid())
  folio          Int    @default(autoincrement())
  originalSaleId String @map("original_sale_id")
  branchId       String @map("branch_id")
  // The cashier who ran the flow. Distinct from authorizedByUserId on
  // purpose: the entire control is that two different people are recorded,
  // one operating and one approving.
  processedByUserId  String @map("processed_by_user_id")
  // The supervisor whose PIN matched, straight from verifySupervisorPin's
  // supervisorId. Non-nullable because a Return row can only ever be
  // written after that check has already passed.
  authorizedByUserId String @map("authorized_by_user_id")

  returnedTotal Decimal @map("returned_total") @db.Decimal(10, 2)
  newItemsTotal Decimal @default(0) @map("new_items_total") @db.Decimal(10, 2)
  // newItemsTotal - returnedTotal, signed: positive = customer owes,
  // negative = refund owed, 0 = even exchange. Stored rather than derived on
  // read so a later change to pricing logic can never retroactively restate
  // what was actually settled at the counter.
  balance    Decimal          @db.Decimal(10, 2)
  resolution ReturnResolution
  // Only meaningful when resolution = CUSTOMER_OWES (how the difference was
  // paid). Reuses the existing PaymentMethod enum shared with
  // Sale/SalePayment — deliberately not a second parallel enum.
  paymentMethod PaymentMethod? @map("payment_method")
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")

  originalSale Sale         @relation(fields: [originalSaleId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  processedBy  User         @relation("ReturnsProcessed", fields: [processedByUserId], references: [id])
  authorizedBy User         @relation("ReturnsAuthorized", fields: [authorizedByUserId], references: [id])
  items        ReturnItem[]

  @@map("returns")
  @@index([branchId, createdAt])
  @@index([originalSaleId])
  @@index([createdAt])
}

model ReturnItem {
  id        String              @id @default(uuid())
  returnId  String              @map("return_id")
  direction ReturnItemDirection
  // Which line of the ORIGINAL ticket this came back against. Null for NEW
  // lines, which have no originating sale item. Not in the task brief's
  // literal field list, but the cumulative over-return rule ("never return
  // more of a line than was ever bought, summed across every prior partial
  // return") is only enforceable if each returned line remembers the exact
  // SaleItem it consumes — matching on productId/variantId alone would
  // conflate two separate lines of the same product on one ticket.
  saleItemId String? @map("sale_item_id")
  productId  String  @map("product_id")
  variantId  String? @map("variant_id")
  quantity   Int
  // Snapshotted at the moment of the return. RETURNED lines carry the
  // original SaleItem unitPrice (the customer is credited what they actually
  // paid, that line's discount included); NEW lines carry today's freshly
  // resolved price (a new item is a new sale and does not inherit the old
  // ticket's promo).
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  // Did this specific line go back onto the sellable shelf? False means it
  // came back damaged/unsellable: no stock movement was applied, but the row
  // is still written so the loss stays auditable. Only meaningful for
  // RETURNED lines; always false for NEW ones.
  restocked Boolean @default(false)

  return   Return          @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem SaleItem?       @relation(fields: [saleItemId], references: [id])
  product  Product         @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("return_items")
  @@index([returnId])
  // The index the cumulative-limit check reads: "everything ever returned
  // against this SaleItem".
  @@index([saleItemId, direction])
}

// ---------- Mermas (shrinkage write-offs) ----------
// Stock that leaves without being sold: testers on the display counter,
// in-store breakage, expiry, gifted samples, and defective units from a
// supplier. Every merma is supervisor-authorized by PIN and carries a
// mandatory written explanation — an unexplained inventory decrement is
// exactly the shape internal theft takes, so `comments` is required at the
// DB level, not merely encouraged in the UI.
//
// A merma deliberately does NOT get its own MovementType. It IS a manual
// stock adjustment (MovementType.ADJUSTMENT) with a specific audited
// reason; the reason lives here, on the document the movement references,
// where it can carry the category, the authorizer and the money impact.

enum MermaType {
  TESTER_EXHIBICION
  DANO_EN_TIENDA
  CADUCIDAD_VENCIDO
  MUESTRA_REGALO_CLIENTE
  DEFECTO_PROVEEDOR
}

model Merma {
  id                 String    @id @default(uuid())
  folio              Int       @default(autoincrement())
  branchId           String    @map("branch_id")
  requestedByUserId  String    @map("requested_by_user_id")
  authorizedByUserId String    @map("authorized_by_user_id")
  type               MermaType
  // Required, not optional — see the note above.
  comments           String
  // Two different losses from the same event, both stored because they
  // answer different questions: cost impact is the real P&L hit (what the
  // business paid for goods it can no longer sell), retail impact is the
  // revenue-equivalent that walked out the door. Snapshotted totals rather
  // than live joins to Product.cost/price, which drift.
  totalCostImpact   Decimal  @map("total_cost_impact") @db.Decimal(10, 2)
  totalRetailImpact Decimal  @map("total_retail_impact") @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  branch       Branch      @relation(fields: [branchId], references: [id])
  requestedBy  User        @relation("MermasRequested", fields: [requestedByUserId], references: [id])
  authorizedBy User        @relation("MermasAuthorized", fields: [authorizedByUserId], references: [id])
  items        MermaItem[]

  @@map("mermas")
  @@index([branchId, createdAt])
  @@index([type])
  @@index([createdAt])
}

model MermaItem {
  id        String  @id @default(uuid())
  mermaId   String  @map("merma_id")
  productId String  @map("product_id")
  variantId String? @map("variant_id")
  quantity  Int
  // Snapshotted from Product.cost / the resolved sale price at write-off
  // time, for the same reason PurchaseItem.unitCost is snapshotted: a
  // historical loss report must keep showing the numbers that were true when
  // the loss happened, independent of later price changes.
  unitCost   Decimal @map("unit_cost") @db.Decimal(10, 2)
  unitRetail Decimal @map("unit_retail") @db.Decimal(10, 2)

  merma   Merma           @relation(fields: [mermaId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("merma_items")
  @@index([mermaId])
}
